{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-node",
    "rootDir": "src-node",
    "declaration": true
  },
  "include": ["src-node/**/*.ts"]
}
